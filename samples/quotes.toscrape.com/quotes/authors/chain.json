{
  "dsl_version": 1,
  "globals": {
    "base_url": "https://quotes.toscrape.com"
  },
  "policy": {
    "on_missing": "drop",
    "on_error": "raise"
  },
  "steps": [
    {
      "key": "authors",
      "parse": {
        "items": [
          ["py", "get", "text"],
          ["css", "@href", "div.quote a[href^='/author/']"],
          ["py", "uniq", ""],
          [
            "each",
            {
              "url": [["py", "str", ""], ["py", "urljoin", "$globals.base_url"]],
              "then": [["const", "author"]]
            }
          ]
        ]
      },
      "out": "TaskList",
      "then": "author"
    }
  ]
}
