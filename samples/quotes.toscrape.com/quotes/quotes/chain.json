{
  "dsl_version": 1,
  "globals": {
    "base_url": "https://quotes.toscrape.com"
  },
  "policy": {
    "on_missing": "drop",
    "on_error": "raise"
  },
  "steps": [
    {
      "key": "quotes",
      "parse": {
        "items": [
          ["py", "get", "text"],
          ["css", "nodes", "div.quote"],
          ["py", "slice", ":20"],
          [
            "each",
            {
              "text": [["css1", "text", "span.text"], ["py", "normalize_space", ""]],
              "author": [["css1", "text", "small.author"], ["py", "normalize_space", ""]],
              "author_url": [
                ["css1", "@href", "a[href^='/author/']"],
                ["py", "urljoin", "$globals.base_url"]
              ],
              "tags": [["css", "text", "div.tags a.tag"]]
            }
          ]
        ]
      },
      "out": "QuoteList"
    }
  ]
}
